# ─────────────────────────────────────────────────────────────
# MedScope 3D — environment config (copy to .env)
# Research/education prototype. Do NOT put real PHI in this system.
# ─────────────────────────────────────────────────────────────

# --- Core ---
APP_ENV=development
ENGINE_VERSION=2026.08.1

# --- Postgres ---
POSTGRES_USER=medscope
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=medscope
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://medscope:change_me_dev_only@db:5432/medscope

# --- Redis (WS pub/sub, session cache, rate limits) ---
REDIS_URL=redis://redis:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000
# Signing secret for session cookies (magic-link auth). Generate a real one.
SESSION_SECRET=change_me_dev_only_min_32_chars_please

# --- ML ---
# Active model artifact resolved via model_registry; this is the on-disk root.
ML_ARTIFACT_DIR=/app/ml/artifacts
# Confidence threshold below which we route to conservative fallback.
ML_CONFIDENCE_THRESHOLD=0.6

# --- Compliance ---
# Default per-user data retention window (days). Audit logs use a separate window.
DEFAULT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# Admin dashboard token (RBAC stand-in until full auth in Phase 6). Empty =
# admin endpoints disabled. Set a strong value in any shared environment.
ADMIN_TOKEN=

# Retention purge scheduler cadence (seconds). 0 disables the background job.
PURGE_INTERVAL_SECONDS=3600

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
