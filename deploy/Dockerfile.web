# MedScope web (Next.js). Build context = repo root (needs workspace packages).
FROM node:20-slim AS deps
WORKDIR /repo
COPY package.json package-lock.json* ./
COPY packages/triage-shared/package.json packages/triage-shared/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm install

FROM node:20-slim AS build
WORKDIR /repo
COPY --from=deps /repo/node_modules ./node_modules
COPY package.json package-lock.json* ./
COPY packages ./packages
COPY apps ./apps
# Public API/WS URLs are INLINED into the client bundle at build time by Next.js
# (NEXT_PUBLIC_*). They must be set here, not at runtime. Defaults keep local dev
# working; a cloud deploy passes its real https/wss origin via --build-arg
# (see deploy/docker-compose.prod.yml).
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ARG NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_WS_BASE_URL=$NEXT_PUBLIC_WS_BASE_URL
RUN npm run build --workspace apps/web

FROM node:20-slim AS run
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# Standalone is traced from the repo root, so it preserves the monorepo layout:
#   /app/apps/web/server.js  +  /app/node_modules (incl. next)  +  /app/packages
# static/ and public/ are copied in beside the app's server.
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
